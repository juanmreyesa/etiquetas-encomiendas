# Copiá a .env y ajustá. Solo bootstrap; el resto se configura en /admin.
# Copy to .env and edit. Bootstrap only; everything else is set in /admin.

# Clave para firmar la sesión de Flask — CAMBIALA / change this
SECRET_KEY=change-me-please

# Clave para cifrar las contraseñas SMTP at-rest (separada de la base).
# Si no se setea, se deriva de SECRET_KEY. No cambiarla con datos ya cargados.
# Key to encrypt SMTP passwords at rest (separate from the DB).
# If unset, it's derived from SECRET_KEY. Don't change it once data exists.
ETIQUETAS_SECRET=change-me-too

# Ruta de la base SQLite dentro del contenedor / SQLite path inside the container
ETIQUETAS_DB=/data/etiquetas.db

# Defaults sembrados en el primer arranque (editables luego en /admin)
# Seeded on first run (editable afterwards in /admin)
PRINTER=Epson_L3210
BASE_URL=http://localhost:8088
